---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'メア',
  url: `${SITE.siteUrl}/author/mea/`,
  sameAs: [
    SITE.xAccount,
    SITE.hubUrl,
    'https://note.com/k_n702',
  ],
};
---

<BaseLayout
  title={`著者プロフィール：メア｜${SITE.name}`}
  description="ポイ活ブログの著者・メアのプロフィールページです。"
  canonicalPath="/author/mea/"
  jsonLd={personLd}
>
  <div class="wrap">
    <p class="breadcrumb"><a href="/mea-poikatsu-blog/">トップ</a> › 著者プロフィール</p>
    <h1>🎀 著者プロフィール：メア</h1>
    <p>メアです♡ ポイ活が大好きで、登録するだけで特典がもらえる紹介コードや、使ってよかったポイントサイトの情報を発信しています。ポイ活って難しそう…という人にも伝わるように、失敗しない始め方を分かりやすくまとめるのが目標です。毎日のポイ活情報はXでも発信中♪</p>
    <h2>リンク</h2>
    <ul>
      <li><a href={SITE.xAccount} target="_blank" rel="noopener">X（@pppppuririn）</a></li>
      <li><a href={SITE.hubUrl} target="_blank" rel="noopener">メアのポイ活メディア（総合案内）</a></li>
      <li><a href="https://note.com/k_n702" target="_blank" rel="noopener">note（メア｜ポイ活・紹介コード）</a></li>
    </ul>
    <p><a href="/mea-poikatsu-blog/">紹介コード一覧トップへ戻る →</a></p>
  </div>
</BaseLayout>
